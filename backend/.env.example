# LLM Configuration
# These are the default LLM settings used when no configs exist in the database

# Default provider-first config. Real API keys belong in backend/.env or the settings UI.
LLM_DEFAULT_ID=modelscope-default
LLM_DEFAULT_NAME=ModelScope
LLM_PROVIDER=modelscope
LLM_API_FORMAT=openai_compatible

# LLM API base URL (OpenAI compatible endpoint, must include /v1)
LLM_BASE_URL=https://api-inference.modelscope.cn/v1

# API key for the LLM service. Do not commit a real key.
LLM_API_KEY=

# Model name to use
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash

# Maximum tokens for response
LLM_MAX_TOKENS=4096

# Temperature for generation (0.0 - 2.0)
LLM_TEMPERATURE=0.2
LLM_SUPPORTS_STREAMING=1
LLM_ENABLED=1

# LLM egress proxy (optional). Empty = direct connection; LLM traffic never
# follows system/environment proxies (toggling Clash etc. used to break calls
# with "Invalid port"). IPv6 must be bracketed, e.g. http://[::1]:7890
# (bare forms like ::1:7890 are auto-normalized).
LLM_PROXY=
# Feed refresh cadence is configured in the app (Settings → 订阅更新), not here.
# Defaults: every feed (YouTube and RSS alike) refreshes once per 12 hours,
# one source per round, transcript fetches throttled to one per 2 minutes.


# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB=podcast

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1

# Auth
# Set AUTH_REQUIRED=1 when you want login required for all API routes.
AUTH_REQUIRED=0
# Local dev only: loopback requests (127.0.0.1) skip login and act as this admin account.
# AUTH_DEV_AUTO_LOGIN=zz
JWT_SECRET=change-this-before-sharing
JWT_EXPIRES_HOURS=168
DEFAULT_OWNER_ID=local-default-user
DEFAULT_OWNER_EMAIL=local@podcast.local
DEFAULT_ADMIN_EMAIL=zz
DEFAULT_ADMIN_PASSWORD=123456

# Transcription
# official | local_whisper | local_whisperx | assemblyai | auto
TRANSCRIPTION_DEFAULT_PROVIDER=official
TRANSCRIPTION_DEFAULT_LANGUAGE=auto
TRANSCRIPTION_AI_NORMALIZE_ENABLED=0
WHISPER_MODEL=base
WHISPER_MODEL_DIR=E:\models\tts
TORCH_HOME=E:\models\tts\torch
# cpu/int8 is safest. For NVIDIA GPU use cuda/float16.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE_INDEX=0
WHISPER_NUM_WORKERS=1
WHISPERX_BATCH_SIZE=16
WHISPERX_VAD_METHOD=silero
WHISPERX_DIARIZE=0
WHISPERX_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
WHISPERX_MIN_SPEAKERS=
WHISPERX_MAX_SPEAKERS=
HF_TOKEN=

# Keep cloud transcription disabled unless you explicitly want paid AssemblyAI calls.
TRANSCRIPTION_CLOUD_ENABLED=0
ASSEMBLYAI_API_KEY=

# AI analysis / summaries
# Keep frozen by default while summary architecture is being rebuilt.
AI_ANALYSIS_ENABLED=0

# ---- 视频源（YouTube / B站）----
# YouTube 访问代理（国内网络必配），如 http://127.0.0.1:7891
YOUTUBE_PROXY=
# Direct proxy pool for YouTube fetching (comma-separated socks5:// or http://
# URLs). When set, IP rotation happens in code and Clash is not involved.
# Generate candidates from your Clash subscription: python scripts/extract_proxy_pool.py
# (note: TLS-wrapped nodes cannot be used directly; use plain socks5/http proxies,
# e.g. from an IP-pool provider or self-hosted entries)
YOUTUBE_PROXY_POOL=
# B站登录态：浏览器 F12 > Application > Cookies > SESSDATA 的值；失效时 B站订阅报 login required
BILI_SESSDATA=
# WhisperX 模型下载镜像（如 https://hf-mirror.com）
HF_ENDPOINT=

# Clash 外部控制器（可选）：限流时自动轮换 YOUTUBE_PROXY 端口对应的节点组
CLASH_API_URL=http://127.0.0.1:9090
CLASH_API_SECRET=
